# ─────────────────────────────────────────────────────────────────────────────
# Sentry configuration. Copy to .env and edit. All values here are safe defaults
# for a local mock-mode demo — the dashboard will populate without any tokens.
# ─────────────────────────────────────────────────────────────────────────────

# Execution modes
#   mock: simulated sessions with realistic timing, no external calls
#   live: calls https://api.devin.ai and github.com
DEVIN_MODE=mock
GITHUB_MODE=mock

# Required when DEVIN_MODE=live. Get from https://app.devin.ai/settings/api-keys
DEVIN_API_KEY=

# Required when GITHUB_MODE=live. Needs `repo` scope on the fork.
GITHUB_TOKEN=

# The fork of apache/superset where issues and PRs will land. In live mode
# this must be a repo you own or have write access to.
TARGET_REPO=your-org/superset-vuln-demo

# Logging
LOG_LEVEL=INFO
